# Ignore dependencies (should be installed inside Docker)
node_modules/

# Ignore build files (should be generated inside Docker)
dist/

# Ignore environment variables & sensitive files
.env
.env.local
.env.*.local

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore Git-related files
.git/
.gitignore

# Ignore editor & OS files
.vscode/
.DS_Store
Thumbs.db
